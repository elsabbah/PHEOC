@model IReadOnlyList<QiraPolicyRow>
@using PHEOC.OMS.Domain.Qira
@{ViewData["Title"]="إعدادات QIRA";var latest=Model.FirstOrDefault();var existing=latest?.Actions??[];}
<div class="page-heading"><div><div class="eyebrow">سياسة وطنية بإصدارات</div><h1>إعدادات QIRA</h1><p>قائمة الأخطار عالية التهديد وإجراءات كل مستوى. لا تُفترض أي قوائم وطنية.</p></div><a class="secondary" href="/Admin/Settings">الإعدادات</a></div>
@if(latest==null){<p class="notice">لم يُعتمد مرجع وطني بعد. تستمر الخوارزمية بإجابة «غير معروف» على الخطر عالي التهديد، مع السماح بقرار فريق موثّق للخطر المستجد.</p>}
@if(Current.Can(Permissions.RiskApprove)){<section class="panel"><h2>إنشاء واعتماد إصدار جديد</h2><p class="muted">يمكن تعديل بيانات آخر إصدار أدناه. الحفظ ينشئ إصداراً مستقلاً للتقييمات الجديدة؛ لا يتغير أي تقييم سابق.</p><form asp-action="Policy" method="post" class="stack"><label>اسم المرجع<input name="Name" required maxlength="160" value="@latest?.Name"/></label><label>المصدر وجهة الاعتماد / مبرر التعديل<textarea name="Reference" required maxlength="2000">@latest?.Reference</textarea></label><label>الأخطار عالية التهديد — خطر واحد بكل سطر<textarea name="Hazards" rows="6" maxlength="12000">@(string.Join("\n",latest?.Hazards??[]))</textarea></label><h3>إجراءات الاستجابة حسب المستوى</h3><p class="muted">اترك عنوان الإجراء فارغاً لتجاهل صفه. الأولوية: 1 عاجلة، 2 متوسطة، 3 اعتيادية. لا تُحفظ إجراءات دون جهة وأولوية ومدة محددة.</p><div id="qira-templates">@for(var i=0;i<Math.Max(5,existing.Count+2);i++){var item=i<existing.Count?existing[i]:null;<fieldset class="qira-template"><legend>إجراء @(i+1)</legend><div class="form-grid"><label>مستوى الخطورة<select name="Actions[@i].Level"><option value="">اختر المستوى</option>@foreach(var risk in Enum.GetValues<QiraRisk>()){<option value="@risk" selected="@(item?.Level==risk)">@QiraText.Risk(risk)</option>}</select></label><label>الجهة المسؤولة<input name="Actions[@i].Organization" value="@item?.Organization" maxlength="450"/></label><label class="full">الإجراء<input name="Actions[@i].Title" value="@item?.Title" maxlength="1000"/></label><label>الأولوية<select name="Actions[@i].Priority"><option value="0">اختر الأولوية</option>@for(var p=1;p<=3;p++){<option value="@p" selected="@(item?.Priority==p)">@p</option>}</select></label><label>الاستحقاق بعد (ساعات)<input name="Actions[@i].DueHours" type="number" min="0" max="8760" value="@(item?.DueHours??0)"/></label></div></fieldset>}</div><button type="button" id="qira-add-template" class="secondary">إضافة صف إجراء</button><button class="primary">اعتماد وحفظ إصدار جديد</button></form></section>}
<section class="panel"><h2>الإصدارات المحفوظة</h2>@if(Model.Count==0){<p class="empty">لا توجد إصدارات معتمدة.</p>}@foreach(var policy in Model){<details class="task-card"><summary>الإصدار @policy.Revision · @policy.Name · @Ui.Time(policy.At)</summary><p>@policy.Reference</p><p>اعتمد بواسطة: @policy.ApprovedBy</p><h3>الأخطار</h3><ul>@foreach(var hazard in policy.Hazards){<li>@hazard</li>}</ul><h3>الإجراءات</h3><ul>@foreach(var action in policy.Actions){<li>@QiraText.Risk(action.Level) · @action.Title · @action.Organization · الأولوية @action.Priority · @action.DueHours ساعة</li>}</ul></details>}</section>
@section Scripts{<script src="~/js/qira-settings.js" asp-append-version="true"></script>}
