@model QiraDetail
@using PHEOC.OMS.Domain.Qira
@{var a=Model.Assessment;var open=Model.Event.Status!=EventStatus.Closed;}
@if(a.State>=QiraState.Completed){<section class="panel"><h2>إجراءات الاستجابة</h2>@if(Model.Actions.Count==0){<p class="empty">لا توجد إجراءات معتمدة لهذا المستوى في المرجع المرتبط بالتقييم.</p>@if(Current.Can(Permissions.AdminSettings)){<a href="/Qira/Configuration">إعداد الإجراءات للتقييمات الجديدة</a>}}
@if(open&&a.State==QiraState.Approved&&Model.Actions.Any(x=>x.TaskId==null)&&Current.Can(Permissions.RiskApprove)&&Current.Can(Permissions.EventsUpdate)){<form asp-action="Share" asp-route-id="@a.Id" method="post"><input name="Version" type="hidden" value="@a.Version"/><button class="primary">إسناد الإجراءات إلى الجهات في مهام الحدث</button><p class="muted">تُنشأ مهام ورسالة تشغيلية داخل التطبيق للمتابعة.</p></form>}
@foreach(var action in Model.Actions){<article class="task-card"><h3>@action.Title</h3><p>الجهة: @action.Organization · الأولوية: @action.Priority · الاستحقاق: @Ui.Time(action.DueAt)</p><p>الحالة: @(Enum.TryParse<TaskState>(action.State,out var state)?Ui.Task(state):"مقترح — بانتظار الإسناد")</p><p class="preserve">@action.Notes</p>@if(open&&action.TaskId.HasValue&&Current.Can(Permissions.EventsUpdate)){<form asp-action="Action" asp-route-id="@action.Id" method="post" class="form-grid"><input name="assessmentId" type="hidden" value="@a.Id"/><input name="Version" type="hidden" value="@action.Version"/><input name="TaskVersion" type="hidden" value="@action.TaskVersion"/><label>الحالة<select name="State">@foreach(var s in Enum.GetValues<TaskState>()){<option value="@s" selected="@(s.ToString()==action.State)">@Ui.Task(s)</option>}</select></label><label>الإنجاز %<input type="number" name="Progress" min="0" max="100" value="@action.Progress" required/></label><label class="full">ملاحظات المتابعة<textarea name="Notes" maxlength="2000">@action.Notes</textarea></label><button class="secondary">تحديث متابعة الإجراء</button></form>}</article>}</section>}
