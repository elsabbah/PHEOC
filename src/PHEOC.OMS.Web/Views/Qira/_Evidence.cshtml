@model QiraDetail
@using PHEOC.OMS.Domain.Qira
@{var a=Model.Assessment;var open=Model.Event.Status!=EventStatus.Closed;}
@{var path=Model.Evaluation.Path;}
<details class="panel qira-secondary" id="qira-evidence"><summary>مسار الإجابات والأدلة والمرفقات</summary><p class="muted">المحاور غير الظاهرة تجاوزتها الخوارزمية في هذا المسار. لا تستخدم النتيجة أوزاناً أو مجموع درجات.</p><ol class="qira-path">@foreach(var nodeId in path){var node=Model.Definition.Nodes.Single(n=>n.Id==nodeId);var entry=Model.Answers.FirstOrDefault(x=>x.Active&&x.Node==nodeId);<li><div class="section-heading"><strong>@node.Number · @node.Arabic</strong><span class="badge">@(entry==null?"بانتظار الإجابة":QiraText.Choice(entry.Choice))</span></div>@if(entry!=null){<p class="preserve">@entry.Notes</p><small>المصدر: @(string.IsNullOrWhiteSpace(entry.Source)?"غير مسجل":entry.Source)</small><p class="preserve">@entry.Evidence</p>@if(entry.AttachmentId.HasValue){<a href="/Communications/Download/@entry.AttachmentId">المرفق الداعم</a>}}@if(Model.Editable){<a class="qira-edit" href="/Qira/Details/@a.Id?node=@nodeId#qira-tree">مراجعة هذه الخطوة</a>}</li>}</ol>
@if(Model.Editable&&Current.Can(Permissions.EventsUpdate)){<details><summary>رفع مرفق للحدث ثم ربطه بإجابة</summary><form asp-action="Upload" asp-route-id="@a.Id" method="post" enctype="multipart/form-data" class="stack"><label>PDF / PNG / JPEG / TXT — حتى 5 MB<input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.txt" required/></label><button class="secondary">رفع المرفق</button></form></details>}</details>