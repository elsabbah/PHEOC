@model QiraDetail
@using PHEOC.OMS.Domain.Qira
@{var a=Model.Assessment;var open=Model.Event.Status!=EventStatus.Closed;}
@if(a.State>=QiraState.Completed){<section class="panel"><div class="section-heading"><h2>نتيجة التقييم</h2><span class="badge">@QiraText.State(a.State)</span></div><div class="qira-result risk-@a.Risk"><strong>@QiraText.Risk(a.Risk)</strong><span>الثقة: @QiraText.Confidence(a.Confidence)</span><span>اكتمل @Ui.Time(a.CompletedAt)</span></div><div class="qira-scale" aria-label="مستويات الخطورة">@foreach(var risk in Enum.GetValues<QiraRisk>()){<span class="risk-@risk @(risk==a.Risk?"selected":"")">@QiraText.Risk(risk)</span>}</div><h3>مبرر الثقة</h3><p class="preserve">@Model.ConfidenceReason</p><h3>المعلومات الناقصة وعدم اليقين</h3><p class="preserve">@(string.IsNullOrWhiteSpace(Model.Uncertainties)?"لم يسجل الفريق فجوات إضافية.":Model.Uncertainties)</p>
@if(!string.IsNullOrWhiteSpace(Model.ReviewNote)){<p><strong>ملاحظات المراجعة:</strong> @Model.ReviewNote</p>}@if(!string.IsNullOrWhiteSpace(Model.ApprovalNote)){<p><strong>ملاحظات الاعتماد:</strong> @Model.ApprovalNote</p>}
@if(open&&Model.AssessedBy!=Current.Id&&a.State==QiraState.Completed&&Current.Can(Permissions.QiraReview)){<form asp-action="Review" asp-route-id="@a.Id" method="post" class="stack"><input name="Version" type="hidden" value="@a.Version"/><label>ملاحظات المراجعة<textarea name="Note" required maxlength="2000"></textarea></label><button class="primary">توثيق المراجعة</button></form>}
@if(open&&Model.AssessedBy!=Current.Id&&a.State==QiraState.Reviewed&&Current.Can(Permissions.RiskApprove)){<form asp-action="Approve" asp-route-id="@a.Id" method="post" class="stack"><input name="Version" type="hidden" value="@a.Version"/><label>مبرر الاعتماد<textarea name="Note" required maxlength="2000"></textarea></label><button class="primary">اعتماد التقييم</button></form>}
@if(Model.AssessedBy==Current.Id&&a.State is QiraState.Completed or QiraState.Reviewed){<p class="notice">تحتاج المراجعة والاعتماد إلى مستخدم مخوّل آخر غير مُعدّ التقييم.</p>}
@if(open&&Current.Can(Permissions.QiraReassess)&&Current.Can(Permissions.RiskCreate)){<form asp-action="Start" method="post" class="qira-inline"><input name="eventId" type="hidden" value="@Model.Event.Id"/><input name="previousId" type="hidden" value="@a.Id"/><button class="secondary">إعادة التقييم بإصدار جديد</button></form>}</section>}
