@model HealthBoard
@{ViewData["Title"]="المخالطون والعينات";}
<div class="page-heading"><div><div class="eyebrow">التنسيق الوبائي المحدود</div><h1>المخالطون والعينات</h1><p>متابعة برموز تشغيلية وسلسلة حيازة العينات. تجنب إدخال أسماء أو أرقام هوية في الملاحظات.</p></div><span class="badge">بيانات مقيدة الصلاحيات</span></div>
@if(Current.Can(Permissions.HealthManage)){<div class="two-column"><section class="panel"><details class="entry"><summary>+ تسجيل مخالط</summary><form asp-action="Contact" method="post" class="stack"><label>الحدث<select name="EventId">@foreach(var e in Model.Events){<option value="@e.Id">@e.Title</option>}</select></label><label>رمز المخالط<input name="Code" required maxlength="80"/></label><label>آخر تعرض (UTC)<input name="LastExposureAt" type="datetime-local" required/></label><label>نهاية المتابعة (UTC)<input name="FollowUpUntil" type="datetime-local" required/></label><label>تصنيف المخاطر<input name="RiskLevel" required maxlength="40"/></label><button class="primary">حفظ المخالط</button></form></details></section><section class="panel"><details class="entry"><summary>+ تسجيل عينة</summary><form asp-action="Sample" method="post" class="stack"><label>الحدث<select name="EventId">@foreach(var e in Model.Events){<option value="@e.Id">@e.Title</option>}</select></label><label>رمز العينة<input name="Code" required maxlength="80"/></label><label>نوع العينة<input name="Type" required maxlength="100"/></label><label>وقت الجمع (UTC)<input name="CollectedAt" type="datetime-local" required/></label><button class="primary">حفظ العينة</button></form></details></section></div>}
<section class="panel"><h2>متابعة المخالطين</h2>@foreach(var c in Model.Contacts){<article class="task-card"><div class="section-heading"><strong>@c.Code — @c.EventTitle</strong><span class="badge">@c.Type</span></div><p>@c.Details</p>@if(Current.Can(Permissions.HealthManage)){<form asp-action="Follow" asp-route-id="@c.Id" method="post" class="filters"><label class="grow">نتيجة المتابعة<input name="Text" required maxlength="1000"/></label><button class="secondary">إضافة متابعة</button></form>}</article>}@if(Model.Contacts.Count==0){<p class="empty">لا توجد سجلات مخالطين.</p>}</section>
<section class="panel"><h2>العينات وسلسلة الحيازة</h2>@foreach(var s in Model.Samples){<article class="task-card"><div class="section-heading"><strong>@s.Code — @s.EventTitle</strong><span class="badge">@s.Type</span></div><p>الجمع: @Ui.Time(s.At)</p><p>@s.Details</p>@if(Current.Can(Permissions.HealthManage)){<details class="entry"><summary>نقل العينة / تسجيل نتيجة</summary><form asp-action="Transfer" asp-route-id="@s.Id" method="post" class="filters"><label>من<input name="From" required maxlength="160"/></label><label>إلى<input name="To" required maxlength="160"/></label><button class="secondary">توثيق النقل</button></form><form asp-action="Result" asp-route-id="@s.Id" method="post" class="filters"><label class="grow">النتيجة<input name="Text" required maxlength="1000"/></label><button class="secondary">تسجيل النتيجة</button></form></details>}</article>}@if(Model.Samples.Count==0){<p class="empty">لا توجد عينات مسجلة.</p>}</section>
