@model IReadOnlyList<ActivityRow>
@{ViewData["Title"]="خطة التحسين";}
<div class="page-heading"><div><div class="eyebrow">التعلم من الاستجابة</div><h1>خطة التحسين بعد الأحداث</h1><p>إجراءات تصحيحية بمسؤول وموعد استحقاق وأدلة تنفيذ.</p></div></div><section class="panel">@foreach(var a in Model){<article class="task-card"><div class="section-heading"><strong>@a.Type</strong><span class="badge">@a.State</span></div><p>@a.Text</p><small>@a.Actor · @Ui.Time(a.At)</small>@if(Current.Can(Permissions.EventsClose)){<form asp-action="UpdateImprovement" asp-route-id="@a.Id" method="post" class="filters"><input name="Version" type="hidden" value="@a.Version"/><label>التقدم %<input name="Progress" type="number" min="0" max="100" required/></label><label class="grow">دليل التنفيذ<input name="Evidence" required maxlength="2000"/></label><button class="secondary">تحديث</button></form>}</article>}@if(Model.Count==0){<div class="empty">تُضاف إجراءات التحسين من مراجعة AAR داخل الحدث المغلق.</div>}</section>
