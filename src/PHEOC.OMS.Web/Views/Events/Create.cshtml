@model EventInput
@{ViewData["Title"]="تسجيل حدث";var governorates=(IReadOnlyList<Lookup>)ViewBag.Governorates;}
<div class="page-heading"><div><div class="eyebrow"><a href="/Events">سجل الأحداث</a> / تسجيل جديد</div><h1>تسجيل حدث صحي</h1><p>سجّل المعلومات الموثقة. اترك البيانات غير المعروفة فارغة.</p></div></div>
<form asp-action="Create" method="post" class="panel form-grid"><div asp-validation-summary="All" class="validation full"></div><h2 class="full">البيانات الأساسية</h2><label class="check full"><input asp-for="IsTraining" type="checkbox"/>حدث تدريبي — يستبعد من مؤشرات التشغيل</label><label class="full">عنوان الحدث *<input asp-for="Title" required maxlength="200"/></label><label>نوع الحدث *<input asp-for="EventType" required maxlength="80" placeholder="مثال: تجمع حالات"/></label><label>نوع التهديد *<input asp-for="ThreatType" required maxlength="80"/></label><label>المحافظة *<select asp-for="GovernorateId" required><option value="">اختر المحافظة</option>@foreach(var g in governorates){<option value="@g.Id">@g.Name</option>}</select></label><label>وصف الموقع<input asp-for="Location" maxlength="500"/></label><label>عدد الحالات<input asp-for="CasesCount" type="number" min="0"/></label><label>عدد الوفيات<input asp-for="DeathsCount" type="number" min="0"/></label><label>خط العرض<input asp-for="Latitude" type="number" min="-90" max="90" step="any" dir="ltr"/></label><label>خط الطول<input asp-for="Longitude" type="number" min="-180" max="180" step="any" dir="ltr"/></label><label class="full">وصف الحدث<textarea asp-for="Description" rows="4" maxlength="4000"></textarea></label><h2 class="full">التواريخ الموثقة <small>أدخل بتوقيت UTC</small></h2><label>بداية الحدث<input asp-for="OccurredAt" type="datetime-local"/></label><label>الاكتشاف<input asp-for="DetectedAt" type="datetime-local"/></label><label>الإخطار<input asp-for="NotifiedAt" type="datetime-local"/></label><label>التحقق<input asp-for="VerifiedAt" type="datetime-local"/></label><label>تأكيد الإشارة<input asp-for="ConfirmedAt" type="datetime-local"/></label><p class="muted">يُسجل وقت الاستلام آلياً من الخادم. لا يُستبدل بأي من هذه التواريخ.</p><div class="actions full"><button class="primary">حفظ الحدث</button><a class="secondary" href="/Events">إلغاء</a></div></form>
