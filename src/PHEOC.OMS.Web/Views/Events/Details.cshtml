@model EventDetails
@{ViewData["Title"]=Model.Event.Title;var e=Model.Event;var open=e.Status!=EventStatus.Closed;}
<div class="page-heading"><div><div class="eyebrow"><a href="/Events">سجل الأحداث</a> / EVT-@e.Id.ToString("D6")</div><h1>@e.Title</h1><p>@e.Governorate · @e.EventType · @e.ThreatType</p>@if(Model.Qira?.Approved is {} currentRisk){<a class="badge risk-@currentRisk.Risk" href="/Qira/Details/@currentRisk.Id">QIRA المعتمد: @QiraText.Risk(currentRisk.Risk)</a>}</div><span class="badge status-@e.Status large">@Ui.Status(e.Status)</span></div>
@if(e.IsTraining){<div class="notice">حدث تدريبي — لا يحتسب ضمن مؤشرات التشغيل الفعلية.</div>}@if(Current.Can(Permissions.ReportsView)){<p><a class="secondary" href="/Analytics/Event/@e.Id">توثيق تواريخ وإجراءات 7-1-7</a></p>}<nav class="section-tabs" aria-label="أقسام الحدث"><a href="#overview">نظرة عامة</a><a href="#risk">المخاطر والتفعيل</a><a href="#ims">هيكل الحادث</a><a href="#tasks">المهام والقرارات</a><a href="#deploy">نشر الفرق</a><a href="#closure">الإغلاق والمراجعة</a><a href="#timeline">السجل الزمني</a></nav>
<section class="panel" id="overview"><h2>الموقف الحالي</h2><div class="facts"><div><small>الموقع</small><strong>@Model.Location</strong></div><div><small>الحالات / الوفيات</small><strong>@(e.Cases?.ToString()??"غير مسجل") / @(e.Deaths?.ToString()??"غير مسجل")</strong></div><div><small>وقت الاستلام</small><strong>@Ui.Time(e.ReceivedAt)</strong></div><div><small>الإحداثيات</small><strong dir="ltr">@(e.Latitude?.ToString()??"—"), @(e.Longitude?.ToString()??"—")</strong></div></div><p class="preserve">@Model.Description</p>
@if(open&&Current.Can(Permissions.EventsUpdate)){<form asp-action="Status" asp-route-id="@e.Id" method="post" class="filters"><input name="Version" type="hidden" value="@Model.Version"/><label>تغيير الحالة<select name="Status"><option value="UnderAssessment">بدء / إعادة التقييم</option><option value="Monitoring">تحت المراقبة</option><option value="ResponseOngoing">بدء الاستجابة الجارية</option></select></label><label class="grow">مبرر الإجراء<input name="Reason" required maxlength="2000"/></label><button class="secondary">تحديث الحالة</button></form>}
</section>
<div class="two-column" id="risk"><section class="panel"><partial name="_QiraSummary" model="@(Model.Qira??new QiraEventSummary(e.Id,null,null))"/></section><section class="panel"><h2>قرار تفعيل الاستجابة</h2><p class="muted">التفعيل قرار معتمد يسجل المسؤول والمبرر. يلزم تقييم QIRA معتمد.</p>@if(open&&Current.Can(Permissions.EventsActivate)){<form asp-action="Activate" asp-route-id="@e.Id" method="post" class="stack"><input name="Version" type="hidden" value="@Model.Version"/><label>مستوى التفعيل<select name="Level" required><option value="1">المستوى الأول</option><option value="2">المستوى الثاني</option><option value="3">المستوى الثالث</option></select></label><label>مبررات القرار<textarea name="Rationale" required maxlength="2000"></textarea></label><button class="primary">اعتماد قرار التفعيل</button></form>}</section></div>
<section class="panel" id="ims"><h2>هيكل إدارة الحادث IMS</h2><div class="organization-grid">@foreach(var a in Model.Assignments){<article class="org-card"><small>@a.Type</small><strong>@a.Text</strong><span>@a.Actor</span></article>}</div>@if(Model.Assignments.Count==0){<p class="empty">لم تُسجل تعيينات بعد.</p>}
@if(open&&Current.Can(Permissions.EventsUpdate)){<details class="entry"><summary>+ تعيين مسؤول / تحديث شاغل منصب</summary><form asp-action="Assign" asp-route-id="@e.Id" method="post" class="form-grid"><label>المنصب<select name="Position"><option>مدير الحادث</option><option>نائب مدير الحادث</option><option>رئيس العمليات</option><option>رئيس التخطيط</option><option>رئيس اللوجستيات</option><option>المسؤول المالي والإداري</option><option>مسؤول المعلومات والاتصال</option></select></label><label>الاسم<input name="PersonName" required maxlength="160"/></label><label>الجهة<input name="Organization" required maxlength="160"/></label><button class="primary">حفظ التعيين</button></form></details>}</section>
<div class="two-column" id="tasks"><section class="panel"><h2>المهام والإجراءات</h2>@foreach(var t in Model.Tasks){<article class="task-card"><div class="section-heading"><strong>@t.Title</strong><span class="badge">@Ui.Task(t.State)</span></div><p class="muted">@t.AssignedTo · الاستحقاق @Ui.Time(t.DueAt)</p><progress value="@t.Progress" max="100"></progress>@if(open&&Current.Can(Permissions.EventsUpdate)){<form asp-action="UpdateTask" asp-route-id="@t.Id" method="post" class="filters compact"><input name="eventId" type="hidden" value="@e.Id"/><input name="Version" type="hidden" value="@t.Version"/><label>الحالة<select name="State">@foreach(var s in Enum.GetValues<TaskState>()){<option value="@s" selected="@(s==t.State)">@Ui.Task(s)</option>}</select></label><label>الإنجاز %<input name="Progress" type="number" min="0" max="100" value="@t.Progress" required/></label><button class="secondary">تحديث</button></form>}</article>}
@if(open&&Current.Can(Permissions.EventsUpdate)){<details class="entry"><summary>+ مهمة جديدة</summary><form asp-action="Task" asp-route-id="@e.Id" method="post" class="stack"><label>عنوان المهمة<input name="Title" required maxlength="200"/></label><label>المسؤول<input name="AssignedTo" required maxlength="450"/></label><label>الاستحقاق (UTC)<input name="DueAt" type="datetime-local" required/></label><button class="primary">إنشاء المهمة</button></form></details>}</section>
<section class="panel"><h2>سجل القرارات</h2><partial name="_Activity" model="Model.Decisions"/>@if(open&&Current.Can(Permissions.EventsUpdate)){<details class="entry"><summary>+ تسجيل قرار / قيد تصحيحي</summary><form asp-action="Decide" asp-route-id="@e.Id" method="post" class="stack"><label>نص القرار<textarea name="Text" required maxlength="4000"></textarea></label><label>تصحيح قرار سابق (اختياري)<select name="CorrectsDecisionId"><option value="">قرار جديد</option>@foreach(var d in Model.Decisions){<option value="@d.Id">#@d.Id</option>}</select></label><button class="primary">حفظ قيد القرار</button></form></details>}</section></div>
<section class="panel" id="deploy"><h2>فرق الاستجابة المكلفة</h2>@foreach(var d in Model.Deployments){<article class="task-card"><strong>@d.TeamName</strong><p>@d.Mission</p><small>النشر: @Ui.Time(d.CreatedAt) · الوصول: @Ui.Time(d.ArrivedAt) · العودة: @Ui.Time(d.ReturnedAt)</small></article>}@if(Model.Deployments.Count==0){<p class="empty">لا توجد فرق مكلفة لهذا الحدث.</p>}@if(open&&Current.Can(Permissions.TeamsDeploy)){<details class="entry"><summary>+ إصدار أمر نشر</summary><form asp-action="Deploy" asp-route-id="@e.Id" method="post" class="stack"><label>الفريق الجاهز<select name="TeamId" required><option value="">اختر الفريق</option>@foreach(var t in Model.Teams){<option value="@t.Id">@t.Name</option>}</select></label><label>مهام التكليف<textarea name="Mission" required maxlength="2000"></textarea></label><button class="primary">اعتماد أمر النشر</button></form></details>}</section>
<section class="panel" id="closure"><h2>الإغلاق والمراجعة بعد الحدث</h2><p class="muted">الإغلاق يحتاج تسوية الموارد وإتمام المهام وعودة الفرق وتقريراً معتمداً واعتماد مستخدم آخر.</p>@foreach(var c in Model.Closures){<article class="task-card"><strong>طلب #@c.Id — @c.Rationale</strong><p>المُعد: @c.RequestedBy · الاعتماد: @(c.ApprovedBy??"بانتظار الاعتماد")</p>@if(open&&c.ApprovedBy==null&&Current.Can(Permissions.EventsClose)){<form asp-action="ApproveClosure" asp-route-id="@c.Id" method="post"><input name="eventId" type="hidden" value="@e.Id"/><input name="Version" type="hidden" value="@c.Version"/><button class="primary" data-confirm="اعتماد إغلاق هذا الحدث؟">اعتماد الإغلاق</button></form>}</article>}
@if(open&&Current.Can(Permissions.EventsClose)){<details class="entry"><summary>+ طلب إغلاق الحدث</summary><form asp-action="Closure" asp-route-id="@e.Id" method="post" class="stack"><label>مبرر الإغلاق<textarea name="Rationale" required maxlength="2000"></textarea></label><label class="check"><input name="ResourcesSettled" type="checkbox" value="true"/>تمت مراجعة وتسوية الموارد</label><label class="check"><input name="EpidemiologyReviewed" type="checkbox" value="true"/>تمت مراجعة الوضع الوبائي</label><label class="check"><input name="FieldReviewed" type="checkbox" value="true"/>تمت مراجعة الإجراءات الميدانية</label>@if(Current.Can(Permissions.CloseExceptional)){<label class="check"><input name="Exceptional" type="checkbox" value="true"/>طلب استثنائي — يتطلب سماح السياسة ومبرراً واعتماداً مستقلاً</label>}<button class="primary">تقديم طلب الإغلاق</button></form></details>}
@if(!open&&Current.Can(Permissions.EventsClose)){<details class="entry"><summary>+ مراجعة بعد الحدث AAR</summary><form asp-action="Aar" asp-route-id="@e.Id" method="post" class="form-grid"><label>ما المتوقع؟<textarea name="Expected" required maxlength="4000"></textarea></label><label>ماذا حدث فعلياً؟<textarea name="Actual" required maxlength="4000"></textarea></label><label>ما الذي سار جيداً؟<textarea name="WentWell" required maxlength="4000"></textarea></label><label>ما الذي يحتاج تحسيناً ولماذا؟<textarea name="Improvements" required maxlength="4000"></textarea></label><button class="primary">حفظ المراجعة</button></form></details>}
@foreach(var r in Model.Reviews){<article class="task-card"><strong>AAR #@r.Id</strong><p>@r.Text</p>@if(Current.Can(Permissions.EventsClose)){<details class="entry"><summary>+ إجراء تحسين</summary><form asp-action="Improve" asp-route-id="@r.Id" method="post" class="form-grid"><input name="eventId" type="hidden" value="@e.Id"/><label>الإجراء<input name="Action" required maxlength="2000"/></label><label>المسؤول<input name="Owner" required maxlength="450"/></label><label>الاستحقاق (UTC)<input name="DueAt" type="datetime-local" required/></label><button class="primary">حفظ الإجراء</button></form></details>}</article>}</section>
<section class="panel" id="timeline"><div class="section-heading"><div><h2>السجل الزمني للحدث</h2><p class="muted">الأحدث أولاً · التواريخ والأوقات بتوقيت مصر</p></div><span class="badge">@Model.Timeline.Count إجراء</span></div><partial name="_Timeline" model="Model.Timeline"/></section>
<div class="two-column"><section class="panel" id="messages"><h2>غرفة اتصالات الحدث</h2><partial name="_Activity" model="(IReadOnlyList<ActivityRow>)ViewBag.Messages"/>@if(open&&Current.Can(Permissions.EventsUpdate)){<form asp-controller="Communications" asp-action="Message" asp-route-id="@e.Id" method="post" class="stack"><label>رسالة تشغيلية<textarea name="Text" required maxlength="2000"></textarea></label><button class="primary">إرسال الرسالة</button></form>}</section><section class="panel"><h2>مرفقات الحدث</h2>@foreach(var a in (IReadOnlyList<AttachmentRow>)ViewBag.Attachments){<article class="task-card"><a href="/Communications/Download/@a.Id">@a.Name</a><small class="block">@a.Size بايت · @Ui.Time(a.At)</small></article>}@if(open&&Current.Can(Permissions.EventsUpdate)){<form asp-controller="Communications" asp-action="Upload" asp-route-id="@e.Id" method="post" enctype="multipart/form-data" class="stack"><label>مرفق حتى 5 MB (PDF / PNG / JPEG / TXT)<input name="file" type="file" accept=".pdf,.png,.jpg,.jpeg,.txt" required/></label><button class="primary">رفع المرفق</button></form>}</section></div>
