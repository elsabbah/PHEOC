@model DashboardModel
@{ViewData["Title"]="سجل الأحداث";var page=int.TryParse(Context.Request.Query["page"],out var p)?Math.Max(1,p):1;}
<div class="page-heading"><div><div class="eyebrow">إدارة الأحداث</div><h1>سجل الأحداث</h1><p>من استلام الإشارة إلى إغلاق الحدث ومراجعة الاستجابة.</p></div>@if(Current.Can(Permissions.EventsCreate)){<a class="primary" href="/Events/Create">+ تسجيل حدث جديد</a>}</div><section class="panel"><form method="get" class="filters"><label>المحافظة<select name="governorate"><option value="">الكل</option>@foreach(var g in Model.Governorates){<option value="@g.Id" selected="@(Context.Request.Query["governorate"]==g.Id.ToString())">@g.Name</option>}</select></label><label>الحالة<select name="status"><option value="">الكل</option>@foreach(var s in Enum.GetValues<EventStatus>()){<option value="@s" selected="@(Context.Request.Query["status"]==s.ToString())">@Ui.Status(s)</option>}</select></label><label class="grow">بحث<input name="query" value="@Context.Request.Query["query"]" placeholder="عنوان الحدث أو نوعه"/></label><button class="primary">بحث</button></form><partial name="_EventTable" model="Model.Events"/><div class="pagination">@if(page>1){<a asp-action="Index" asp-route-page="@(page-1)" asp-route-query="@Context.Request.Query["query"]" asp-route-status="@Context.Request.Query["status"]" asp-route-governorate="@Context.Request.Query["governorate"]">السابق</a>}<span>صفحة @(page) · 30 سجلاً لكل صفحة</span>@if(Model.Events.Count==30){<a asp-action="Index" asp-route-page="@(page+1)" asp-route-query="@Context.Request.Query["query"]" asp-route-status="@Context.Request.Query["status"]" asp-route-governorate="@Context.Request.Query["governorate"]">التالي</a>}</div></section>
