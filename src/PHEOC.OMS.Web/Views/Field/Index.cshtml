@model FieldBoard
@{ViewData["Title"]="العمليات الميدانية";}
<div class="page-heading"><div><div class="eyebrow">المتابعة الميدانية</div><h1>العمليات الميدانية</h1><p>تقارير إجراءات الاستجابة والاحتياجات المرتبطة بأوامر النشر.</p></div></div><div class="two-column"><section class="panel"><h2>تقرير ميداني جديد</h2><form asp-action="Report" method="post" class="stack" data-field-form data-subject="@Current.Id"><input name="ClientRequestId" type="hidden" value="@Guid.NewGuid()"/><label>أمر النشر<select name="DeploymentId" required><option value="">اختر التكليف</option>@foreach(var d in Model.Deployments.Where(x=>x.ReturnedAt==null)){<option value="@d.Id">#@d.Id — @d.TeamName / @d.EventTitle</option>}</select></label><label>الإجراءات المنفذة<textarea name="Activities" required maxlength="4000" rows="5"></textarea></label><label>الاحتياجات<textarea name="Needs" maxlength="2000"></textarea></label><div class="notice">الموقع اختياري. لا يجري تتبع مستمر للأفراد.</div><label>خط العرض<input name="Latitude" type="number" step="any" min="-90" max="90"/></label><label>خط الطول<input name="Longitude" type="number" step="any" min="-180" max="180"/></label><label class="check"><input id="draft-consent" type="checkbox"/>السماح بحفظ مسودة مشفرة مؤقتة على هذا الجهاز عند انقطاع الاتصال (24 ساعة / 10 مسودات). لا تدرج بيانات شخصية.</label><button class="primary">إرسال التقرير</button><p class="muted" id="draft-status" role="status"></p><div class="actions"><button type="button" class="secondary" id="sync-drafts">مزامنة المسودات</button><button type="button" class="secondary" id="clear-drafts">مسح المسودات</button></div></form></section><section class="panel"><h2>آخر التقارير الميدانية</h2><partial name="_Activity" model="Model.Reports"/></section></div>

@section Scripts {<script src="~/js/field-drafts.js" defer></script>}

<section class="panel sos-panel"><h2>نداء طوارئ SOS</h2><p>يتطلب اتصالاً بالخادم. يُسجل التنبيه داخل غرفة العمليات؛ لا يؤكد إرسال رسالة عبر مزود خارجي.</p><form asp-action="Sos" method="post" class="filters" data-sos><label>أمر النشر<select name="deploymentId" required>@foreach(var d in Model.Deployments.Where(x=>x.ReturnedAt==null)){<option value="@d.Id">#@d.Id — @d.TeamName</option>}</select></label><label class="grow">وصف الحالة الطارئة<input name="Text" required maxlength="1000"/></label><button class="primary danger" data-confirm="تسجيل نداء طوارئ إلى غرفة العمليات؟">تسجيل نداء SOS</button><p class="muted full" id="sos-status" role="status"></p></form></section>
