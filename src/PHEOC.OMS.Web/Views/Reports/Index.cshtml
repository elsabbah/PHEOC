@model IReadOnlyList<ReportRow>
@{ViewData["Title"]="التقارير الموقفية";var events=(IReadOnlyList<EventRow>)ViewBag.Events;}
<div class="page-heading"><div><div class="eyebrow">المعلومات واتخاذ القرار</div><h1>التقارير الموقفية SitRep</h1><p>إصدارات محفوظة مع لقطة البيانات وقت الإعداد واعتماد مستقل.</p></div><a class="secondary" href="/Reports/Excel">تصدير Excel</a></div>
@if(Current.Can(Permissions.ReportsCreate)){<section class="panel"><details class="entry"><summary>+ إعداد تقرير موقفي</summary><form asp-action="Create" method="post" class="form-grid"><label class="full">الحدث<select name="EventId" required>@foreach(var e in events){<option value="@e.Id">@e.Title</option>}</select></label><label class="full">الملخص التنفيذي<textarea name="Summary" required maxlength="4000" rows="4"></textarea></label><label>التحديات<textarea name="Challenges" maxlength="4000"></textarea></label><label>الإجراءات القادمة والقرارات المطلوبة<textarea name="NextActions" required maxlength="4000"></textarea></label><button class="primary">حفظ إصدار جديد</button></form></details></section>}
<div class="team-grid">@foreach(var r in Model){<article class="panel"><div class="section-heading"><span class="badge">إصدار @r.Version</span><span class="badge">@(r.ApprovedBy==null?"مسودة بانتظار الاعتماد":"معتمد")</span></div><h2><a href="/Events/Details/@r.EventId">@r.EventTitle</a></h2><p class="preserve">@r.Summary</p><p class="muted">@Ui.Time(r.At)</p><div class="actions"><a class="secondary" href="/Reports/Word/@r.Id">Word</a><a class="secondary" href="/Reports/Print/@r.Id">طباعة / PDF</a>@if(Current.Can(Permissions.ReportsApprove)&&r.ApprovedBy==null){<form asp-action="Approve" asp-route-id="@r.Id" method="post"><button class="primary">اعتماد</button></form>}</div></article>}@if(Model.Count==0){<section class="panel empty">لا توجد تقارير موقفية بعد.</section>}</div>
