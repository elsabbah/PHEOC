@model CommunicationBoard
@{ViewData["Title"]="الإشعارات ومستويات الخدمة";}
<div class="page-heading"><div><div class="eyebrow">المتابعة والتصعيد</div><h1>الإشعارات ومستويات الخدمة</h1><p>تنبيهات داخلية ومتابعة مدد SLA وفق نسخ السياسات المعتمدة وقت استلام الحدث.</p></div></div><section class="panel"><h2>مركز الإشعارات</h2>@foreach(var n in Model.Notifications){<article class="task-card"><div class="section-heading"><a href="/Events/Details/@n.EventId">@n.EventTitle</a><span class="badge">@(n.Read?"مقروء":"جديد")</span></div><p>@n.Text</p><small>@Ui.Time(n.At)</small>@if(!n.Read){<form asp-action="Read" asp-route-id="@n.Id" method="post"><button class="secondary">تحديد كمقروء</button></form>}</article>}@if(Model.Notifications.Count==0){<div class="empty">لا توجد إشعارات حالياً.</div>}</section><section class="panel"><h2>متابعة SLA</h2><div class="table-scroll"><table><thead><tr><th>الحدث</th><th>السياسة / النسخة</th><th>الهدف بالدقائق</th><th>البداية</th><th>الإتمام</th><th>النتيجة</th><th>التصعيد</th></tr></thead><tbody>@foreach(var s in Model.Slas){<tr><td><a href="/Events/Details/@s.EventId">@s.EventTitle</a></td><td>@s.Name / v@s.Version</td><td>@s.TargetMinutes</td><td>@Ui.Time(s.StartedAt)</td><td>@Ui.Time(s.CompletedAt)</td><td>@(s.Compliant==null?"قيد المتابعة":s.Compliant==true?"ضمن الهدف":"متأخر")</td><td>@s.EscalationLevel</td></tr>}</tbody></table></div><p class="muted">سياسات SLA الداخلية مستقلة عن معيار 7-1-7. يرتبط الحدث بالنسخ المتاحة عند استلامه؛ إضافة نسخة جديدة تؤثر في الأحداث الجديدة فقط.</p></section>
@if(Current.Can(Permissions.AdminSettings)){<div class="two-column"><section class="panel"><h2>اعتماد سياسة SLA جديدة</h2><form asp-action="Sla" method="post" class="stack"><label>اسم السياسة<input name="Name" required maxlength="100"/></label><label>المرحلة (من وقت الاستلام)<select name="Stage"><option value="Acknowledge">الإقرار بالاستلام</option><option value="Assessment">تقييم المخاطر</option><option value="Activation">التفعيل</option><option value="Deployment">نشر الفريق</option><option value="FirstResponse">أول إجراء استجابة</option></select></label><label>المدة المستهدفة بالدقائق<input name="TargetMinutes" type="number" min="1" max="525600" required/></label><label>تكرار التصعيد بالدقائق (حتى المستوى الثالث)<input name="EscalateEveryMinutes" type="number" min="1" max="525600" required/></label><button class="primary">اعتماد نسخة جديدة</button></form></section><section class="panel"><h2>سجل نسخ السياسات</h2><partial name="_Activity" model="Model.Definitions"/></section></div>}
