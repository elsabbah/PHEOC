@model IReadOnlyList<UserRow>
@{ViewData["Title"]="المستخدمون والصلاحيات";var governorates=(IReadOnlyList<Lookup>)ViewBag.Governorates;}
<div class="page-heading"><div><div class="eyebrow">إدارة الوصول</div><h1>المستخدمون والصلاحيات</h1><p>الصلاحيات صريحة، مع إمكانية قصر نطاق البيانات على محافظة.</p></div></div><section class="panel"><details class="entry"><summary>+ إنشاء مستخدم</summary><form asp-action="CreateUser" method="post" class="form-grid" data-user-create><label>اسم المستخدم<input name="UserName" required maxlength="100" autocomplete="off" dir="ltr"/></label><label>كلمة المرور الأولية<input name="Password" type="password" required minlength="12" maxlength="128" autocomplete="new-password" dir="ltr"/></label><label>الدور<select name="Role" required><option value="">اختر الدور صراحة</option>@foreach(var role in Permissions.Roles){<option value="@role" data-permissions="@string.Join(",",RolePermissionDefaults.For(role))">@role</option>}</select></label><label>نطاق البيانات<select name="GovernorateId"><option value="">مركزي — جميع المحافظات</option>@foreach(var g in governorates){<option value="@g.Id">@g.Name</option>}</select></label><p class="notice full">تحتاج كلمة المرور 12 حرفاً على الأقل مع أحرف كبيرة وصغيرة وأرقام ورمز. اختر Events.View لاستخدام الواجهة. اختيار الدور يحدد صلاحياته الافتراضية، ويمكنك إضافة أو إلغاء أي صلاحية قبل الحفظ. تغيير الدور يعيد تطبيق افتراضياته. للحساب الجديد تُطبّق الاختيارات المحفوظة حتى مع دور System Administrator، وهذا الدور يتطلب نطاقاً مركزياً.</p><fieldset class="full"><legend>الصلاحيات</legend><div class="section-heading"><p class="muted" data-permission-summary role="status" aria-live="polite"></p><button type="button" class="secondary" data-restore-role disabled>إعادة صلاحيات الدور الافتراضية</button></div><div class="permission-grid">@foreach(var permission in Permissions.All){<label class="check"><input type="checkbox" name="Permissions" value="@permission" data-central="@(RolePermissionDefaults.RequiresCentralScope(permission) ? "true" : "false")" checked="@(permission==Permissions.EventsView)"/><span dir="ltr">@permission</span></label>}</div></fieldset><button class="primary">إنشاء المستخدم</button></form></details></section><section class="panel"><div class="table-scroll"><table><thead><tr><th>المستخدم</th><th>الدور</th><th>النطاق</th><th>الصلاحيات الفعلية</th><th>إدارة الحساب</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Name</td><td>@u.Roles</td><td>@(u.GovernorateId.HasValue?governorates.FirstOrDefault(g=>g.Id==u.GovernorateId)?.Name:"مركزي")</td><td class="permission-text" dir="ltr">@u.Permissions</td><td><a class="secondary" href="/Admin/EditPermissions/@u.Id">تعديل الصلاحيات</a><span class="badge">@(u.Disabled?"معطل / مقفل":"مفعّل")</span>@if(u.Id!=Current.Id){<form asp-action="DisableUser" asp-route-id="@u.Id" method="post"><input name="disabled" type="hidden" value="@(u.Disabled ? "false" : "true")"/><button class="secondary">@(u.Disabled?"تفعيل الحساب":"تعطيل الحساب")</button></form>}<details class="entry"><summary>إعادة تعيين كلمة المرور</summary><form asp-action="ResetPassword" asp-route-id="@u.Id" method="post" class="stack"><label>كلمة مرور جديدة<input name="Password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required/></label><button class="secondary">حفظ</button></form></details></td></tr>}</tbody></table></div></section>

@section Scripts{<script src="~/js/user-permissions.js" asp-append-version="true" defer></script>}
