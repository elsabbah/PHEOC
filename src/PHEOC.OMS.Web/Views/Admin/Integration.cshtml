@model IntegrationBoard
@{ViewData["Title"]="مراقبة التكامل";}
<div class="page-heading"><div><div class="eyebrow">EBS · Inbox / Outbox</div><h1>مراقبة التكامل</h1><p>سجل استقبال الرسائل وطابور تحديثات الأحداث.</p></div></div><div class="notice">يبقى الإرسال Pending عند عدم تهيئة مزود EBS. الحالة Sent تعني قبول طلب HTTP، ولا تثبت التسليم النهائي. عقد الاستقبال الحالي مقترح v1 ويحتاج مواءمة مع EBS الفعلي.</div><section class="panel"><h2>الرسائل المستلمة</h2><div class="table-scroll"><table><thead><tr><th>الرسالة</th><th>معرف الحدث الخارجي</th><th>الحدث المحلي</th><th>الاستلام</th></tr></thead><tbody>@foreach(var m in Model.Inbox){<tr><td>#@m.Id</td><td>@m.ExternalId</td><td><a href="/Events/Details/@m.EventId">#@m.EventId</a></td><td>@Ui.Time(m.ReceivedAt)</td></tr>}</tbody></table></div></section><section class="panel"><h2>طابور الإرسال</h2><partial name="_Activity" model="Model.Outbox"/></section>
