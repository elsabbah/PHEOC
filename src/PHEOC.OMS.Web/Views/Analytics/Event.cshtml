@model KpiEventDetails
@using PHEOC.OMS.Domain.Rules
@{ViewData["Title"]="توثيق 7-1-7";}
<div class="page-heading"><div><div class="eyebrow"><a href="/Events/Details/@Model.EventId">العودة إلى الحدث</a></div><h1>توثيق 7-1-7 — @Model.Title</h1></div></div>@if(Model.IsTraining){<div class="notice">حدث تدريبي؛ يمكن توثيق إجراءاته للتدريب ويُستبعد من لوحة المؤشرات.</div>}
<div class="two-column"><section class="panel"><h2>تواريخ المؤشر الموثقة</h2><p class="muted">النشوء والاكتشاف والإخطار مفاهيم مستقلة. لا تستبدل الإخطار بتاريخ استلام PHEOC أو تأكيد الإشارة. كل حفظ ينشئ قيداً جديداً مع الاحتفاظ بالتاريخ السابق.</p>@if(Current.Can(Permissions.ReportsCreate)){<form asp-action="Dates" asp-route-id="@Model.EventId" method="post" class="stack"><label>تاريخ نشوء الحدث<input name="Emergence" type="date"/></label><label>تاريخ الاكتشاف<input name="Detection" type="date"/></label><label>تاريخ إخطار أول جهة مسؤولة عن الاستجابة<input name="Notification" type="date"/></label><label class="check"><input name="Excluded" type="checkbox" value="true"/>استبعاد الحدث صراحة من التحليل</label><label>مصدر التواريخ / مبرر الاستبعاد<textarea name="Evidence" required maxlength="2000"></textarea></label><button class="primary">حفظ قيد التواريخ</button></form>}<partial name="_Activity" model="Model.Dates"/></section><section class="panel"><h2>الإجراءات المبكرة السبعة</h2>@if(Current.Can(Permissions.ReportsCreate)){<form asp-action="Milestone" asp-route-id="@Model.EventId" method="post" class="stack"><label>الإجراء<select name="Action">@foreach(var a in SevenOneSeven.Names){<option value="@a.Key">@a.Value</option>}</select></label><label>تاريخ بلوغ مرحلة الإجراء<input name="Date" type="date"/></label><label class="check"><input name="NotApplicable" type="checkbox" value="true"/>لا ينطبق (اترك التاريخ فارغاً واذكر المبرر)</label><label>الدليل / سبب عدم الانطباق أو غياب التاريخ<textarea name="Evidence" required maxlength="2000"></textarea></label><button class="primary">حفظ قيد الإجراء</button></form>}<partial name="_Activity" model="Model.Milestones"/></section></div>
