@model KpiEventDetails
@using PHEOC.OMS.Domain.Rules
@{ViewData["Title"]="توثيق 7-1-7";}
<div class="page-heading"><div><div class="eyebrow"><a href="/Events/Details/@Model.EventId">العودة إلى الحدث</a></div><h1>توثيق 7-1-7 — @Model.Title</h1></div></div>@if(Model.IsTraining){<div class="notice">حدث تدريبي؛ يمكن توثيق إجراءاته للتدريب ويُستبعد من لوحة المؤشرات.</div>}
@if(Model.HasEgyptEbsSource){
<section class="panel" data-kpi-source data-source-url="@Url.Action("SourceDates",new{id=Model.EventId})">
<div class="section-heading"><h2>تواريخ متاحة من EgyptEBS</h2><button class="secondary" type="button" data-kpi-refresh>تحديث من المصدر</button></div>
<p data-kpi-source-status role="status" aria-live="polite">جارٍ قراءة تواريخ الإشارة المرتبطة...</p>
<div data-kpi-source-result hidden><dl class="qira-scope"><dt>بداية الحدث · Signals.EventStartDate</dt><dd data-kpi-emergence dir="ltr"></dd><dt>الاكتشاف · Signals.DetectionDate</dt><dd data-kpi-detection dir="ltr"></dd><dt>أول استجابة مسجلة · Responses.CreatedAt</dt><dd data-kpi-response dir="ltr"></dd><dt>حالة الاستجابة في المصدر</dt><dd data-kpi-response-state></dd><dt>إخطار أول جهة مسؤولة عن الاستجابة · تاريخ أول Responses.CreatedAt</dt><dd data-kpi-notification dir="ltr"></dd></dl><p class="muted" data-kpi-source-notice></p>
@if(Current.Can(Permissions.ReportsCreate)){<button class="secondary" type="button" data-kpi-apply>استخدام التواريخ المتاحة في الحقول الفارغة</button><p class="muted">لن تُستبدل القيم الموجودة، ولن تتغير حالة الاستبعاد. راجع التواريخ ومصدرها ثم احفظ قيد التواريخ أدناه لتدخل في الحساب.</p>}
</div></section>}
<div class="two-column"><section class="panel"><h2>تواريخ المؤشر الموثقة</h2><p class="muted">النشوء والاكتشاف والإخطار مفاهيم مستقلة. لا تستبدل الإخطار بتاريخ استلام PHEOC أو تأكيد الإشارة. كل حفظ ينشئ قيداً جديداً مع الاحتفاظ بالتاريخ السابق.</p>@if(Current.Can(Permissions.ReportsCreate)){<form asp-action="Dates" asp-route-id="@Model.EventId" method="post" class="stack" data-kpi-dates><label>تاريخ نشوء الحدث<input name="Emergence" type="date" value="@(Model.CurrentDates?.Emergence?.ToString("yyyy-MM-dd"))"/></label><label>تاريخ الاكتشاف<input name="Detection" type="date" value="@(Model.CurrentDates?.Detection?.ToString("yyyy-MM-dd"))"/></label><label>تاريخ إخطار أول جهة مسؤولة عن الاستجابة<input name="Notification" type="date" value="@(Model.CurrentDates?.Notification?.ToString("yyyy-MM-dd"))"/></label><label class="check"><input name="Excluded" type="checkbox" value="true" checked="@(Model.CurrentDates?.Excluded??false)"/>استبعاد الحدث صراحة من التحليل</label><label>مصدر التواريخ / مبرر الاستبعاد<textarea name="Evidence" required maxlength="2000">@Model.CurrentDates?.Evidence</textarea></label><button class="primary">حفظ قيد التواريخ</button></form>}<partial name="_Activity" model="Model.Dates"/></section><section class="panel"><h2>الإجراءات المبكرة السبعة</h2>@if(Current.Can(Permissions.ReportsCreate)){<form asp-action="Milestone" asp-route-id="@Model.EventId" method="post" class="stack"><label>الإجراء<select name="Action">@foreach(var a in SevenOneSeven.Names){<option value="@a.Key">@a.Value</option>}</select></label><label>تاريخ بلوغ مرحلة الإجراء<input name="Date" type="date"/></label><label class="check"><input name="NotApplicable" type="checkbox" value="true"/>لا ينطبق (اترك التاريخ فارغاً واذكر المبرر)</label><label>الدليل / سبب عدم الانطباق أو غياب التاريخ<textarea name="Evidence" required maxlength="2000"></textarea></label><button class="primary">حفظ قيد الإجراء</button></form>}<partial name="_Activity" model="Model.Milestones"/></section></div>

@section Scripts{<script src="~/js/kpi-source-dates.js" asp-append-version="true" defer></script>}
