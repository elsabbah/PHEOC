@model IReadOnlyList<KpiEventRow>
@{ViewData["Title"]="مؤشرات 7-1-7";var included=Model.Where(x=>!x.Excluded).ToList();var detectionDen=included.Count(x=>x.Result.DetectionMet.HasValue);var notificationDen=included.Count(x=>x.Result.NotificationMet.HasValue);var responseDen=included.Count(x=>x.Result.ResponseMet.HasValue);var overallDen=included.Count(x=>x.Result.OverallMet.HasValue);string Rate(int num,int den)=>den==0?"غير قابل للحساب":$"{100.0*num/den:0.0}% ({num}/{den})";string Days(int? days)=>days==null?"غير مكتمل":days==0?"<1":days.ToString()!;}
<div class="page-heading"><div><div class="eyebrow">الاكتشاف · الإخطار · الاستجابة المبكرة</div><h1>مؤشرات 7-1-7</h1><p>تعتمد على تواريخ موثقة للمؤشر وإتمام جميع الإجراءات المنطبقة، بصورة مستقلة عن SLA الداخلي.</p></div></div><section class="kpi-grid"><article class="kpi"><span>الاكتشاف خلال 7 أيام</span><strong class="rate">@Rate(included.Count(x=>x.Result.DetectionMet==true),detectionDen)</strong></article><article class="kpi"><span>الإخطار خلال يوم</span><strong class="rate">@Rate(included.Count(x=>x.Result.NotificationMet==true),notificationDen)</strong></article><article class="kpi teal"><span>الاستجابة خلال 7 أيام</span><strong class="rate">@Rate(included.Count(x=>x.Result.ResponseMet==true),responseDen)</strong></article><article class="kpi"><span>تحقيق الأهداف الثلاثة</span><strong class="rate">@Rate(included.Count(x=>x.Result.OverallMet==true),overallDen)</strong></article></section><section class="panel"><div class="table-scroll"><table><thead><tr><th>الحدث</th><th>الاكتشاف (أيام)</th><th>الإخطار (أيام)</th><th>الاستجابة (أيام)</th><th>جودة البيانات / الاستبعاد</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><a href="/Analytics/Event/@e.Id">@e.Title</a></td><td>@Days(e.Result.DetectionDays)</td><td>@Days(e.Result.NotificationDays)</td><td>@Days(e.Result.ResponseDays)</td><td>@(e.Excluded?"مستبعد: "+e.Evidence:e.Result.DataIssue)</td></tr>}</tbody></table></div><p class="muted">النطاق: أحدث 500 حدث غير تدريبي ضمن الصلاحيات. البسط: الأحداث المستوفية للهدف؛ المقام: الأحداث المشمولة ذات البيانات الصالحة لكل مؤشر. نقص التواريخ يُعرض منفصلاً ولا يُحسب كنجاح. مستبعد صراحة: @Model.Count(x=>x.Excluded)، بيانات غير مكتملة إجمالاً: @included.Count(x=>!x.Result.OverallMet.HasValue).</p><p class="muted">الحساب بفروق التواريخ؛ الاستجابة = تاريخ آخر إجراء منطبق ناقص تاريخ الإخطار. عرض مدد اليوم نفسه «&lt;1». <a href="https://717alliance.org/faq/" target="_blank" rel="noopener noreferrer">مرجع المنهجية</a>.</p></section>
