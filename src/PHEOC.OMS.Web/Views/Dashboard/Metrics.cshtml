@model IReadOnlyList<MetricsRow>
@{ViewData["Title"]="مؤشرات الأداء";}
<div class="page-heading"><div><div class="eyebrow">جودة وتوقيت الاستجابة</div><h1>مؤشرات الأداء الزمنية</h1><p>مدد موثقة بالأيام؛ البيانات المفقودة أو التسلسل غير الصحيح لا تُعامل كصفر.</p></div></div><div class="notice">هذه مدد تحليلية أولية. اكتمال منهجية 7-1-7 يتطلب تعريف إجراءات الاستجابة الأساسية واعتماد المنهجية؛ بدء أول إجراء وحده لا يثبت استيفاء معيار الاستجابة.</div><section class="panel"><div class="table-scroll"><table><thead><tr><th>الحدث</th><th>البداية ← الاكتشاف</th><th>الاكتشاف ← الإخطار</th><th>الإخطار ← أول إجراء</th></tr></thead><tbody>@foreach(var m in Model){<tr><td><a href="/Events/Details/@m.Id">@m.Title</a></td><td>@(m.DetectionDays?.ToString("0.00")??"غير قابل للحساب")</td><td>@(m.NotificationDays?.ToString("0.00")??"غير قابل للحساب")</td><td>@(m.FirstActionDays?.ToString("0.00")??"غير قابل للحساب")</td></tr>}</tbody></table></div><p class="muted">المصدر: تواريخ الحدث الأصلية. نطاق العرض: أحدث 500 حدث متاح للصلاحية. لم تُحتسب نسب امتثال معيارية بعد.</p></section>
