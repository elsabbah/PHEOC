@model DashboardModel
@{ViewData["Title"]="غرفة العمليات";}
<div class="wall" data-wall><div class="page-heading"><div><div class="eyebrow">COMMON OPERATING PICTURE</div><h1>غرفة عمليات طوارئ الصحة العامة</h1></div><span id="wall-clock">@Ui.Time(DateTime.UtcNow)</span></div><section class="kpi-grid"><article class="kpi"><span>أحداث نشطة</span><strong>@Model.Active</strong></article><article class="kpi amber"><span>قيد التقييم</span><strong>@Model.UnderAssessment</strong></article><article class="kpi teal"><span>استجابة مفعّلة</span><strong>@Model.Activated</strong></article><article class="kpi"><span>مهام متأخرة</span><strong>@Model.OverdueTasks</strong></article></section><section class="panel"><h2>الأحداث الحالية</h2><partial name="_EventTable" model="Model.Events.Where(x=>!x.IsTraining&&x.Status!=EventStatus.Closed).ToList()"/></section><div class="two-column"><section class="panel"><h2>تحديثات العمليات</h2><partial name="_Activity" model="Model.Recent"/></section><section class="panel"><h2>الجاهزية والموارد</h2><div class="wall-number">@Model.ReadyTeams <span>فريق جاهز</span></div><div class="wall-number">@Model.DeployedTeams <span>فريق مكلف أو في الموقع</span></div><div class="wall-number">@Model.LowStock <span>دفعة مخزون منخفضة</span></div></section></div></div>
