@model DashboardModel
@{ViewData["Title"]="لوحة القيادة التنفيذية";}
<div class="page-heading"><div><div class="eyebrow">الصورة التشغيلية المشتركة</div><h1>لوحة القيادة التنفيذية</h1><p>متابعة الأحداث والجاهزية وأولويات الاستجابة في مكان واحد.</p></div><div class="actions"><a class="secondary" href="/Dashboard/Wall">شاشة العمليات</a>@if(Current.Can(Permissions.EventsCreate)){<a class="primary" href="/Events/Create">+ تسجيل حدث</a>}</div></div>
<div class="overview-banner"><div><span class="live-dot"></span><strong>الموقف التشغيلي الحالي</strong><p>المؤشرات مستمدة من السجلات ضمن نطاق صلاحياتك ومرشحاتك.</p></div><div class="banner-date">@Ui.Time(DateTime.UtcNow)<small>توقيت القاهرة</small></div></div>
<section class="kpi-grid" aria-label="مؤشرات التشغيل"><article class="kpi"><span>الأحداث النشطة</span><strong>@Model.Active</strong><small>جميع الأحداث غير المغلقة</small></article><article class="kpi amber"><span>قيد التقييم</span><strong>@Model.UnderAssessment</strong><small>بانتظار استكمال التقييم</small></article><article class="kpi teal"><span>الاستجابة المفعّلة</span><strong>@Model.Activated</strong><small>تفعيل أو استجابة جارية</small></article><article class="kpi"><span>الأحداث المغلقة</span><strong>@Model.Closed</strong><small>إغلاق موثّق ومعتمد</small></article></section>
<section class="readiness-grid"><div class="readiness"><span class="metric-icon">♧</span><div><strong>@Model.ReadyTeams</strong><span>فرق جاهزة</span></div></div><div class="readiness"><span class="metric-icon">⌖</span><div><strong>@Model.DeployedTeams</strong><span>فرق مكلفة أو في الموقع</span></div></div><div class="readiness"><span class="metric-icon">▤</span><div><strong>@Model.OpenTasks <small>/ @Model.OverdueTasks متأخرة</small></strong><span>المهام المفتوحة</span></div></div><div class="readiness"><span class="metric-icon">▦</span><div><strong>@Model.LowStock</strong><span>دفعات أقل من الحد الأدنى</span></div></div></section>
<section class="panel"><div class="section-heading"><div><h2>سجل الأحداث</h2><p>أحدث الأحداث ضمن النطاق المحدد</p></div><a href="/Events">عرض السجل الكامل ←</a></div><form method="get" class="filters"><label>المحافظة<select name="governorate"><option value="">جميع المحافظات المتاحة</option>@foreach(var g in Model.Governorates){<option value="@g.Id" selected="@(Context.Request.Query["governorate"]==g.Id.ToString())">@g.Name</option>}</select></label><label>الحالة<select name="status"><option value="">جميع الحالات</option>@foreach(var s in Enum.GetValues<EventStatus>()){<option value="@s" selected="@(Context.Request.Query["status"]==s.ToString())">@Ui.Status(s)</option>}</select></label><label class="grow">بحث<input name="query" value="@Context.Request.Query["query"]" placeholder="عنوان الحدث أو نوعه" maxlength="200"/></label><button class="secondary">تطبيق المرشحات</button><a class="text-link" href="/">مسح</a></form><partial name="_EventTable" model="Model.Events"/></section>
<div class="two-column"><section class="panel"><div class="section-heading"><h2>آخر المستجدات</h2><span class="badge">سجل زمني</span></div><partial name="_Activity" model="Model.Recent"/></section><section class="panel"><div class="section-heading"><h2>التوزيع الجغرافي</h2><span class="badge">الأحداث المعروضة</span></div>@if(Model.Events.All(x=>x.IsTraining)){<div class="empty">يظهر التوزيع عند تسجيل الأحداث.</div>}@foreach(var g in Model.Events.Where(x=>!x.IsTraining).GroupBy(x=>x.Governorate).OrderByDescending(x=>x.Count())){<div class="distribution"><span>@g.Key</span><progress value="@g.Count()" max="@Math.Max(1,Model.Events.Count(x=>!x.IsTraining))"></progress><strong>@g.Count()</strong></div>}<p class="muted">يعكس آخر 30 حدثاً معروضاً؛ الإجماليات بالأعلى تشمل نتائج الترشيح كاملة.</p></section></div>
