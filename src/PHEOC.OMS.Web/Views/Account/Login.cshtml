@model PHEOC.OMS.Web.Controllers.LoginInput
@{ViewData["Title"]="تسجيل الدخول";}
<div class="login-wrap"><section class="login-identity"><div class="eyebrow">وزارة الصحة والسكان · جمهورية مصر العربية</div><div class="login-symbol">✚</div><h1>الجاهزية تبدأ<br/>بصورة واضحة.</h1><p>منظومة موحدة لقيادة وتنسيق عمليات الاستجابة لطوارئ الصحة العامة.</p><div class="identity-line">PHEOC-OMS <span>PUBLIC HEALTH EMERGENCY OPERATIONS</span></div></section><section class="login-panel"><div class="eyebrow">بوابة العمليات</div><h2>مرحباً بعودتك</h2><p class="muted">أدخل بيانات حسابك للوصول إلى مساحة العمل.</p><form asp-action="Login" method="post" class="stack">@if(!ViewData.ModelState.IsValid){<div class="validation" role="alert"><ul>@foreach(var error in ViewData.ModelState.Values.SelectMany(x=>x.Errors)){<li>@error.ErrorMessage</li>}</ul></div>}<input type="hidden" asp-for="ReturnUrl"/><label>اسم المستخدم<input asp-for="UserName" autocomplete="username" required autofocus dir="ltr" maxlength="100"/></label><label>كلمة المرور<input asp-for="Password" type="password" value="" autocomplete="current-password" required dir="ltr" maxlength="128"/></label><button class="primary">تسجيل الدخول ←</button></form><p class="security-note">دخول مخصص للمستخدمين المخولين. تُسجل الإجراءات التشغيلية لأغراض التدقيق.</p></section></div>
