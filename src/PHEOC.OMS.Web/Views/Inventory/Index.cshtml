@model InventoryBoard
@{ViewData["Title"]="الموارد والمخزون";var events=(IReadOnlyList<EventRow>)ViewBag.Events;}
<div class="page-heading"><div><div class="eyebrow">الإمداد واللوجستيات</div><h1>الموارد والمخزون</h1><p>أرصدة الدفعات وحركات التوريد والصرف المرتبطة بالأحداث.</p></div><span class="badge">@Model.Stock.Count دفعة</span></div>
<section class="panel"><h2>الأرصدة المتاحة</h2><div class="table-scroll"><table><thead><tr><th>الصنف / الدفعة</th><th>المستودع</th><th>الصلاحية</th><th>الرصيد</th><th>الحالة</th><th>حركة جديدة</th></tr></thead><tbody>@foreach(var b in Model.Stock){<tr><td><strong>@b.Item</strong><small class="block">@b.Batch</small></td><td>@b.Warehouse</td><td>@(b.ExpiresAt?.ToString("yyyy-MM-dd")??"غير محددة")</td><td>@b.Balance @b.Unit</td><td><span class="badge">@(b.ExpiresAt<DateTime.UtcNow.Date?"منتهية":b.Balance<b.Minimum?"منخفض":"متاح")</span></td><td>@if(Current.Can(Permissions.InventoryManage)){<details><summary>توريد / صرف</summary><form asp-action="Move" asp-route-id="@b.Id" method="post" class="stack"><input name="Version" type="hidden" value="@b.Version"/><label>الكمية (الصرف بالسالب)<input name="Quantity" type="number" step="0.001" required/></label><label>الحدث<select name="EventId"><option value="">دون حدث (توريد فقط)</option>@foreach(var e in events.Where(x=>x.Status!=EventStatus.Closed)){<option value="@e.Id">@e.Title</option>}</select></label><label>المبرر<input name="Reason" required maxlength="2000"/></label><button class="primary">تسجيل الحركة</button></form><hr/><form asp-controller="Logistics" asp-action="Transfer" asp-route-id="@b.Id" method="post" class="stack"><input name="Version" type="hidden" value="@b.Version"/><label>التحويل إلى مستودع<select name="ToWarehouseId" required>@foreach(var w in Model.Warehouses){<option value="@w.Id">@w.Name</option>}</select></label><label>الكمية<input name="Quantity" type="number" min="0.001" step="0.001" required/></label><label>مبرر التحويل<input name="Reason" required maxlength="2000"/></label><button class="secondary">تحويل المخزون</button></form></details>}</td></tr>}@if(Model.Stock.Count==0){<tr><td colspan="6" class="empty">لم تُسجل دفعات مخزون بعد.</td></tr>}</tbody></table></div></section>
@if(Current.Can(Permissions.InventoryManage)){<div class="three-column"><section class="panel"><details class="entry"><summary>+ مستودع</summary><form asp-action="Warehouse" method="post" class="stack"><label>الاسم<input name="Name" required maxlength="160"/></label><label>المحافظة<select name="GovernorateId">@foreach(var g in Model.Governorates){<option value="@g.Id">@g.Name</option>}</select></label><button class="primary">حفظ</button></form></details></section><section class="panel"><details class="entry"><summary>+ صنف</summary><form asp-action="Item" method="post" class="stack"><label>اسم الصنف<input name="Name" required maxlength="160"/></label><label>وحدة القياس<input name="Unit" required maxlength="40"/></label><label>الحد الأدنى<input name="Minimum" type="number" step="0.001" min="0" required/></label><button class="primary">حفظ</button></form></details></section><section class="panel"><details class="entry"><summary>+ دفعة ورصيد افتتاحي</summary><form asp-action="Batch" method="post" class="stack"><label>المستودع<select name="WarehouseId" required>@foreach(var w in Model.Warehouses){<option value="@w.Id">@w.Name</option>}</select></label><label>الصنف<select name="ItemId" required>@foreach(var i in Model.Items){<option value="@i.Id">@i.Name</option>}</select></label><label>رقم الدفعة<input name="BatchNumber" required maxlength="80"/></label><label>انتهاء الصلاحية<input name="ExpiresAt" type="date"/></label><label>الكمية<input name="Quantity" type="number" step="0.001" min="0.001" required/></label><button class="primary">حفظ الدفعة</button></form></details></section></div>}
<section class="panel"><h2>دفتر حركات المخزون</h2><div class="table-scroll"><table><thead><tr><th>الصنف</th><th>الكمية</th><th>المبرر</th><th>المسؤول</th><th>التاريخ</th></tr></thead><tbody>@foreach(var m in Model.Movements){<tr><td>@m.Item</td><td dir="ltr">@m.Quantity</td><td>@m.Reason</td><td>@m.Actor</td><td>@Ui.Time(m.At)</td></tr>}</tbody></table></div></section>
