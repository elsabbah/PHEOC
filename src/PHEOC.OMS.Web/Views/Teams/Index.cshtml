@model TeamBoard
@{ViewData["Title"]="فرق الاستجابة السريعة";}
<div class="page-heading"><div><div class="eyebrow">الجاهزية والنشر</div><h1>فرق الاستجابة السريعة</h1><p>الأفراد والتخصصات والفرق وأوامر النشر المعتمدة.</p></div><span class="badge">@Model.Teams.Count فريق</span></div>
<section class="team-grid">@foreach(var t in Model.Teams){<article class="panel team-card"><div class="section-heading"><h2>@t.Name</h2><span class="badge">@Ui.Team(t.State)</span></div><p>@t.Governorate</p><p class="muted">@t.Members</p></article>}@if(Model.Teams.Count==0){<div class="panel empty">أضف الأفراد أولاً ثم شكّل فريق الاستجابة.</div>}</section>
@if(Current.Can(Permissions.TeamsManage)){<div class="two-column"><section class="panel"><details class="entry"><summary>+ إضافة فرد</summary><form asp-action="Person" method="post" class="form-grid"><label>الاسم<input name="Name" required maxlength="160"/></label><label>الرقم الوظيفي<input name="EmployeeNumber" required maxlength="80"/></label><label>الجهة<input name="Organization" required maxlength="160"/></label><label>التخصص<input name="Specialty" required maxlength="120"/></label><label>المهارات<input name="Skills" maxlength="120"/></label><label>الهاتف<input name="Phone" maxlength="80" dir="ltr"/></label><label>المحافظة<select name="GovernorateId" required>@foreach(var g in Model.Governorates){<option value="@g.Id">@g.Name</option>}</select></label><button class="primary">حفظ الفرد</button></form></details></section><section class="panel"><details class="entry"><summary>+ تشكيل فريق</summary><form asp-action="Team" method="post" class="stack"><label>اسم الفريق<input name="Name" required maxlength="160"/></label><label>المحافظة<select name="GovernorateId">@foreach(var g in Model.Governorates){<option value="@g.Id">@g.Name</option>}</select></label><fieldset><legend>أعضاء الفريق</legend>@foreach(var p in Model.People.Where(x=>x.Available)){<label class="check"><input type="checkbox" name="PersonIds" value="@p.Id"/>@p.Name — @p.Specialty</label>}</fieldset><label>قائد الفريق<select name="LeaderId" required><option value="">اختر أحد الأعضاء المحددين</option>@foreach(var p in Model.People.Where(x=>x.Available)){<option value="@p.Id">@p.Name</option>}</select></label><button class="primary">إنشاء الفريق</button></form></details></section></div>}
<section class="panel"><h2>لوحة أوامر النشر</h2><div class="table-scroll"><table><thead><tr><th>الأمر / الحدث</th><th>الفريق والتكليف</th><th>النشر</th><th>الوصول</th><th>العودة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var d in Model.Deployments){<tr><td>#@d.Id <a href="/Events/Details/@d.EventId">@d.EventTitle</a></td><td><strong>@d.TeamName</strong><small class="block">@d.Mission</small></td><td>@Ui.Time(d.CreatedAt)</td><td>@Ui.Time(d.ArrivedAt)</td><td>@Ui.Time(d.ReturnedAt)</td><td>@if(Current.Can(Permissions.TeamsDeploy)&&d.ReturnedAt==null){<form asp-action="@(d.ArrivedAt.HasValue?"Return":"Arrive")" asp-route-id="@d.Id" method="post"><input name="Version" type="hidden" value="@d.Version"/><button class="secondary">@(d.ArrivedAt.HasValue?"تسجيل العودة":"تسجيل الوصول")</button></form>}</td></tr>}@if(Model.Deployments.Count==0){<tr><td colspan="6" class="empty">تصدر أوامر النشر من صفحة الحدث بعد تفعيله.</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>دليل الأفراد</h2><div class="table-scroll"><table><thead><tr><th>الاسم</th><th>الرقم الوظيفي</th><th>التخصص</th><th>الجهة</th></tr></thead><tbody>@foreach(var p in Model.People){<tr><td>@p.Name</td><td>@p.EmployeeNumber</td><td>@p.Specialty</td><td>@p.Organization</td></tr>}</tbody></table></div></section>
