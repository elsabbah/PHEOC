@model IReadOnlyList<ActivityRow>
@{ViewData["Title"]="سياسات الإغلاق";}
<div class="page-heading"><div><div class="eyebrow">إعدادات التشغيل والاعتماد</div><h1>سياسات إغلاق الأحداث</h1><p>يرتبط كل طلب إغلاق بالنسخة المعتمدة وقت تقديمه. تُحفظ النسخ السابقة دون تعديل.</p></div></div><div class="two-column"><section class="panel"><h2>اعتماد نسخة جديدة</h2><form asp-action="Closure" method="post" class="stack"><label>اسم السياسة<input name="Name" required maxlength="120"/></label><label class="check"><input name="RequireCompletedTasks" type="checkbox" value="true" checked/>اشتراط إتمام المهام</label><label class="check"><input name="RequireApprovedReport" type="checkbox" value="true" checked/>اشتراط تقرير معتمد</label><label class="check"><input name="RequireResourcesSettled" type="checkbox" value="true" checked/>اشتراط تسوية الموارد</label><label class="check"><input name="RequireEpidemiologyReview" type="checkbox" value="true" checked/>اشتراط المراجعة الوبائية</label><label class="check"><input name="RequireFieldReview" type="checkbox" value="true" checked/>اشتراط مراجعة العمليات الميدانية</label><label class="check"><input name="AllowExceptional" type="checkbox" value="true"/>السماح بطلب إغلاق استثنائي بصلاحية خاصة</label><p class="muted">عودة الفرق واعتماد مستخدم آخر شرطان ثابتان. قبل اعتماد أول نسخة، تُطبق الشروط الأساسية جميعها دون إغلاق استثنائي.</p><button class="primary">اعتماد السياسة</button></form></section><section class="panel"><h2>الإصدارات المعتمدة</h2><partial name="_Activity" model="Model"/></section></div>
