@model LogisticsBoard
@{ViewData["Title"]="الإمداد والمركبات";}
<div class="page-heading"><div><div class="eyebrow">التنسيق اللوجستي</div><h1>طلبات الإمداد والمركبات</h1><p>اعتماد وصرف الطلبات مع الفصل بين مقدم الطلب والمعتمد، وتكليف المركبات لأوامر النشر.</p></div></div>
@if(Current.Can(Permissions.InventoryManage)){<div class="two-column"><section class="panel"><details class="entry"><summary>+ طلب إمداد</summary><form asp-action="CreateRequest" method="post" class="stack"><label>الحدث<select name="EventId" required>@foreach(var e in Model.Events.Where(x=>x.Status!=EventStatus.Closed)){<option value="@e.Id">@e.Title</option>}</select></label><label>الصنف<select name="ItemId" required>@foreach(var i in Model.Items){<option value="@i.Id">@i.Name</option>}</select></label><label>الكمية<input name="Quantity" type="number" step="0.001" min="0.001" required/></label><label>المبرر<textarea name="Reason" required maxlength="2000"></textarea></label><button class="primary">تقديم الطلب</button></form></details></section><section class="panel"><details class="entry"><summary>+ تسجيل مركبة</summary><form asp-action="Vehicle" method="post" class="stack"><label>رقم اللوحة<input name="PlateNumber" required maxlength="80"/></label><label>نوع المركبة<input name="Type" required maxlength="120"/></label><label>المحافظة<select name="GovernorateId">@foreach(var g in Model.Governorates){<option value="@g.Id">@g.Name</option>}</select></label><button class="primary">حفظ المركبة</button></form></details></section></div>}
<section class="panel"><h2>طلبات الإمداد</h2><div class="table-scroll"><table><thead><tr><th>الطلب / الحدث</th><th>الصنف</th><th>الكمية والمبرر</th><th>الحالة</th><th>الاعتماد والصرف</th></tr></thead><tbody>@foreach(var r in Model.Requests){<tr><td>#@r.Id <a href="/Events/Details/@r.EventId">@r.EventTitle</a></td><td>@r.Item</td><td>@r.Quantity<small class="block">@r.Reason</small></td><td>@(r.ApprovedBy==null?"بانتظار الاعتماد":"تم الصرف")</td><td>@if(Current.Can(Permissions.InventoryManage)&&r.ApprovedBy==null){<form asp-action="Approve" asp-route-id="@r.Id" method="post" class="stack"><input name="Version" type="hidden" value="@r.Version"/><label>الدفعة<select name="BatchId" required><option value="">اختر دفعة الصنف</option>@foreach(var b in Model.Stock.Where(x=>x.Item==r.Item&&x.Balance>=r.Quantity)){<option value="@b.Id">@b.Warehouse / @b.Batch — @b.Balance</option>}</select></label><button class="primary">اعتماد وصرف</button></form>}</td></tr>}</tbody></table></div></section>
<section class="panel"><h2>المركبات</h2><div class="table-scroll"><table><thead><tr><th>اللوحة</th><th>النوع</th><th>المحافظة</th><th>الحالة</th></tr></thead><tbody>@foreach(var v in Model.Vehicles){<tr><td>@v.Plate</td><td>@v.Type</td><td>@v.Governorate</td><td><span class="badge">@(v.Available?"متاحة":"مكلفة")</span></td></tr>}</tbody></table></div>@if(Current.Can(Permissions.InventoryManage)){<details class="entry"><summary>+ تكليف مركبة</summary><form asp-action="Assign" method="post" class="filters"><label>المركبة<select name="VehicleId">@foreach(var v in Model.Vehicles.Where(x=>x.Available)){<option value="@v.Id">@v.Plate</option>}</select></label><label>أمر النشر<select name="DeploymentId">@foreach(var d in Model.Deployments){<option value="@d.Id">#@d.Id @d.TeamName / @d.EventTitle</option>}</select></label><button class="primary">تكليف</button></form></details>}</section>
<section class="panel"><h2>سجل تكليف المركبات</h2>@foreach(var a in Model.Assignments){<article class="task-card"><strong>@a.Plate — @a.Team</strong><p>@a.EventTitle · التكليف @Ui.Time(a.At) · العودة @Ui.Time(a.ReturnedAt)</p>@if(Current.Can(Permissions.InventoryManage)&&a.ReturnedAt==null){<form asp-action="Return" asp-route-id="@a.Id" method="post"><input name="Version" type="hidden" value="@a.Version"/><button class="secondary">تسجيل عودة المركبة</button></form>}</article>}</section>
